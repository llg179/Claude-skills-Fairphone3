[Unit]
Description=Bring the USB developer network up at boot, without unlocking the screen
After=usb-moded.service
Wants=usb-moded.service

[Service]
Type=oneshot
RemainAfterExit=yes
# usb-moded parks the gadget in charging_only until the session decides
# otherwise, which is why this link used to need an unlock *and* a physical
# replug: no host-side operation can make the phone re-evaluate its mode,
# because none of them drops VBUS. Asking usb-moded over D-Bus does the same
# job from the inside. Retry for a while: usb-moded may still be settling and
# can overrule a request made too early.
#
# Note the $$ escaping -- systemd would otherwise expand $i itself and hand the
# shell an empty variable, which silently breaks the loop guard.
ExecStart=/bin/sh -c 'i=0; while [ $$i -lt 30 ]; do \
	if [ -e /sys/kernel/config/usb_gadget/g1/configs/c.1/rndis.usb0 ]; then \
		echo "rndis up after $$i tries"; exit 0; \
	fi; \
	dbus-send --system --dest=com.meego.usb_moded /com/meego/usb_moded \
		com.meego.usb_moded.set_mode string:rndis_adb >/dev/null 2>&1; \
	sleep 5; i=$$((i+1)); \
done; echo "gave up waiting for rndis after $$i tries"; exit 0'

[Install]
WantedBy=multi-user.target
